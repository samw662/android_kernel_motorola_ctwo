# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
